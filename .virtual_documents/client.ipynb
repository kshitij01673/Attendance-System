import requests
import import_ipynb
from utils import qrread as qr
import msvcrt

SERVER_URL = "http://192.168.1.8:8000/attendance"
DEVICE_ID = "Devf01673"


def scan_user():
    print("\nProgram initiated. \nScanning QR")
    try:
        details = qr.scan_camera()
        print("QR Scanned Sucessfully !!!!")
        print(f"Name: {details["Name"]} \nID : {details["id"]}\n")
    except Exception as e:
        print(f"An error occured : {e} ")
    data = {
        "name": str(details["Name"]),
        "user_id": int(details["id"]),
        "secret_code": str(details["auth_code"]),
        "device_id": str(DEVICE_ID)
    }

    return data


def send_attendance():
    data = scan_user()

    try:
        response = requests.post(
            SERVER_URL,
            json=data,
            timeout=5
        )

        print("Status:", response.status_code)
        response.raise_for_status()

        result = response.json()

        if result["success"]:
            print("Attendance Marked Successfully")
        else:
            print("Failed:", result["message"])

        return result

    except requests.exceptions.RequestException as e:
        print("Server Error:", e)
        return None


if __name__ == "__main__":
    while True:
        input("Press Enter key to start.")
        send_attendance()



