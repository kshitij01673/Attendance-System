import import_ipynb
from lisence_system import generate_keypair

private_pem, public_pem = generate_keypair()

with open("issuer-private.pem", "wb") as f:
    f.write(private_pem)

with open("issuer-public.pem", "wb") as f:
    f.write(public_pem)

print("Created issuer-private.pem")
print("Created issuer-public.pem")









