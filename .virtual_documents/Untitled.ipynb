import sqlite3
import import_ipynb
from utils import dbms_controller as db
from utils import qrgen as qg


conn = sqlite3.connect("utils/attendance.db")


def add_user():
    try:        
        name = input("Whatis the name of the user you want to add: ")
        user_id, secret = db.add_user(conn,name)
        print(f"User id of user : {user_id}")
        print(f"Secret of user : {secret}")
        print("Generating QR")
        qg.generate_qr({"Name": name, "id": str(user_id), "auth_code":str(secret) })
        print("QR generated and Saved Successfully")
    except Exception as e:
        print(f"An error occured: {e}")
add_user()



