class AttendanceRequest(BaseModel):
    name: str
    user_id: int
    secret_code: str
    device_id: str


# ==========================================================
# Response Model
# ==========================================================

class AttendanceResponse(BaseModel):
    success: bool
    message: str

# Database Object
conn = sqlite3.connect("utils/attendance.db")


